# Smart Routing Simulator - Environment Configuration Example

# Server host & port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Cost calculation weights (sum should ideally equal 1.0)
COST_WEIGHT_BW=0.4
COST_WEIGHT_DELAY=0.3
COST_WEIGHT_CONG=0.3

# Cost normalization scaling ceilings (must be > 0)
COST_MAX_BW_MBPS=1000.0
COST_MAX_DELAY_MS=100.0
